// Product Module Schema (Product, ProductStatus, ProductCondition)

enum ProductStatus {
  AVAILABLE
  ACTIVE
  SOLD
  ARCHIVED

  @@map("product_status_enum")
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED

  @@map("product_condition_enum")
}

model Product {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  description  String           @db.Text
  price        Decimal          @db.Decimal(12, 2)
  isNegotiable Boolean          @default(false) @map("is_negotiable")
  condition    ProductCondition @default(USED)
  status       ProductStatus    @default(AVAILABLE)
  images       String[]         @default([])
  location     String?
  viewsCount   Int              @default(0) @map("views_count")
  sellerId     String           @map("seller_id")
  categoryId   String?          @map("category_id")
  areaId       String?          @map("area_id")
  stock        Int              @default(10)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  wishlists     Wishlist[]
  conversations Conversation[] @relation("ProductConversations")
  cartItems     CartItem[]

  @@index([sellerId], map: "idx_products_seller_id")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([areaId], map: "idx_products_area_id")
  @@map("products")
}
